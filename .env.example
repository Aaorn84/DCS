# Server only. Never put API keys in EXPO_PUBLIC_* variables or the mobile app.
# With no key the chat endpoint explicitly returns demo replies.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Production backend (secrets are server-only).
CADDIE_ENV=production
CADDIE_DATABASE_URL=
CADDIE_REDIS_URL=
CADDIE_API_WORKERS=2
CADDIE_HTTP_THREADS=8
CADDIE_HTTP_INFLIGHT=8
CADDIE_CORE_WORKERS=2
CADDIE_CORE_WAITERS=8
CADDIE_DB_POOL_SIZE=8
CADDIE_DB_WAITERS=8
CADDIE_TRUSTED_PROXIES=127.0.0.1/32
CADDIE_CORS_ORIGINS=
CADDIE_METRICS_TOKEN=
